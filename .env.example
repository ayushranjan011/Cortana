# Copy this file to .env and set one provider key
# Preferred for your setup:
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.2
OPENROUTER_MAX_TOKENS=512
# Optional ranking headers for OpenRouter:
# OPENROUTER_SITE_URL=https://your-site-url.example
# OPENROUTER_SITE_NAME=Your Site Name

# Optional OpenAI fallback:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
